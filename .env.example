# 复制成 .env 再改（.env 已被 .gitignore 排除，不会被提交）：
#   cp .env.example .env
# 这里是标准 dotenv 写法（KEY=VALUE，不要写 export 或 ${VAR:-}），因为文件由 node --env-file 读取。
# 命令行里传的同名变量优先于本文件：LLM_ANNOTATE=1 ./scripts/update.sh

# ── LLM（OpenAI 兼容接口）──
# base_url 结尾不要带 /v1，程序自己拼 /chat/completions
#   智谱   https://open.bigmodel.cn/api/paas/v4   模型 glm-4.7        key 在 https://bigmodel.cn 控制台
#   DeepSeek https://api.deepseek.com              模型 deepseek-flash  key 在 https://platform.deepseek.com/api_keys
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=这里填你的APIKEY
LLM_MODEL=glm-4.7

# 同时在途的 AI 请求数。逐条标注 + 逐事件打分都是小请求，这个数决定整轮耗时；遇到成片 429 就往下降。
LLM_CONCURRENCY=8
# 单个请求失败后的重试次数（只有 429/5xx 会重试，指数退避并遵守 Retry-After）
LLM_RETRIES=3
# 每分钟最多发多少个请求，0 = 不限。免费额度按分钟限速时填这个
LLM_RPM=60
# 混合推理模型的思考开关：disabled = 请求体带 thinking:{type:"disabled"}，更省更快；留空则交给服务端默认
LLM_THINKING=disabled
# 逐条标注开关：0 = 一条都不发，标题用原文、分类用该源在 sources/sources.yaml 里声明的 category（首轮那 ~700 次标注全省）
LLM_ANNOTATE=1
# 逐事件打分开关：0 = 一条都不发，所有事件记 0 分
LLM_SCORE=1

# 排序口径：sources = 独立来源数 → AI 分数 → 事件最新报道时间；score = 分数 → 来源数 → 时间
SORT_BY=sources
# 必留门槛：分数或独立来源数达标的事件一定输出、且不占每类 20 条的名额；0 = 该维度不生效
MIN_SCORE=0
MIN_SOURCES=0

# 1 = 每次运行都把原始抓取和每一次 AI 调用的 prompt/响应写到 output/debug/（等价于 ./scripts/update.sh --dump）
DIGEST_DUMP=0

# ── 抓国外源用的代理；直连或 NAS 上整段删掉即可 ──
# docker-compose.yml 用的是 network_mode: host，容器里的 127.0.0.1 就是宿主自己，这两行照默认填即可；
# 换成桥接网络（去掉 network_mode、改回 ports 映射）时，这里必须填代理所在机器的局域网地址，
# 因为容器里的 localhost 指的是容器自己
http_proxy=http://localhost:7890
https_proxy=http://localhost:7890
NODE_USE_ENV_PROXY=1
# 逗号/空格分隔的免代理地址；自建 RSSHub 在内网的话，把它加进来，否则请求会被代理截走
no_proxy=localhost 127.0.0.1 ::1

# ── 对外 HTTP 服务（scripts/serve.sh 用，跑流水线时不需要）──
SERVE_PORT=8080
# 0.0.0.0 = 局域网里的手机能访问；只想本机用就填 127.0.0.1
SERVE_HOST=0.0.0.0

# ── 容器里的定时自跑（docker run ... news-digest loop 用，本机手动跑不需要）──
# 每天到这个点自己跑一轮流水线，HH:MM，24 小时制；不填就是 02:00
SCHEDULE_TIME=02:00
# 不带这一行容器默认 UTC，output/ 里带分钟的文件名和 feed 里的时间会差 8 小时
TZ=Asia/Shanghai

# ── GitHub Pages 发布 ──
# 流水线跑完把 output/ 里的 feed.xml 与 digest.md 用 GitHub Contents API 推到 Pages 仓库，
# 订阅地址用 https://<用户名>.github.io/<目录>/feed.xml，鸿蒙 RSS 客户端不再因 file:// 报 2300003。
# 需要 fine-grained PAT：Repository access 只勾目标仓库，Permissions 只给 Contents: Read and write。
# PAGES_REPO / PAGES_DIR / PAGES_TOKEN 三者缺任何一个都不发布（跳过并打一行日志）。
# GitHub Pages 发布目标：owner/repo、分支、仓库内目录（不带首尾 /）
PAGES_REPO=zhh7ce/zhh7ce.github.io
PAGES_BRANCH=main
PAGES_DIR=static/news-digest
# Contents API 的 Contents 写权限令牌，只授权上面那一个仓库
PAGES_TOKEN=
# feed.xml 对外的固定地址，写进 channel 的 <link> 和 <atom:link>；
# 留空则退回站点前缀 + /feed.xml，两者都没有时启动即报错
FEED_URL=https://zhh7ce.github.io/static/news-digest/feed.xml
# 仅测试用：指向本地假 GitHub API，默认 https://api.github.com
PAGES_API_BASE=
